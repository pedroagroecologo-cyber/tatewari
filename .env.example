# Copia este archivo a .env y ajusta los valores.
# El archivo .env NO se versiona (esta en .gitignore).

# Correo de contacto para las APIs academicas.
# PON AQUI TU PROPIO CORREO. El valor de abajo es un hueco que hay que
# rellenar, no un valor que funcione: con el puesto tal cual, Unpaywall
# rechaza la peticion y OpenAlex te deja en la cola anonima.
#
# Unpaywall lo EXIGE: sin el, rechaza la peticion.
# OpenAlex y Crossref lo usan para meterte en su cola educada, que responde
# mas rapido y con menos cortes.
TATEWARI_MAILTO=tu.correo@institucion.edu

# Clave gratuita de OpenAlex: crea una cuenta en openalex.org y copiala de
# openalex.org/settings/api. Multiplica por diez las consultas diarias.
# Opcional. Viaja en una cabecera, nunca en la URL de la bitacora.
TATEWARI_OPENALEX_KEY=

# Ollama local. Es el unico modelo de lenguaje del proyecto.
TATEWARI_OLLAMA=http://localhost:11434

# Carpeta de salida de las revisiones. No se versiona.
TATEWARI_DATOS=./revisiones

# Knowledge Studio: el Vault de Obsidian donde se escriben las notas.
# Ruta absoluta, o relativa a esta carpeta. Tatewari solo escribe dentro de
# el y dentro de TATEWARI_DATOS. Ejemplo en Windows (barras normales):
#   TATEWARI_OBSIDIAN_VAULT=C:/Users/tu-usuario/Documents/ZEA MAYZ
TATEWARI_OBSIDIAN_VAULT=

# Modelos de Ollama por tarea. Vacios, Tatewari elige el mejor que entre en
# 4 GB de VRAM (un 3B-4B cuantizado). Con una tarjeta mayor, por ejemplo:
#   TATEWARI_MODELO_SINTESIS=qwen3:8b
TATEWARI_MODELO_EXTRACCION=
TATEWARI_MODELO_SINTESIS=
