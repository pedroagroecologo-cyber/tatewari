# Copia este archivo a .env y ajusta los valores.
# El archivo .env NO se versiona (esta en .gitignore).

# Correo de contacto para las APIs academicas.
# Unpaywall lo EXIGE: sin el, rechaza la peticion.
# OpenAlex y Crossref lo usan para meterte en su cola educada, que responde
# mas rapido y con menos cortes.
TATEWARI_MAILTO=tu.correo@institucion.edu

# Ollama local. Es el unico modelo de lenguaje del proyecto.
TATEWARI_OLLAMA=http://localhost:11434

# Carpeta de salida de las revisiones. No se versiona.
TATEWARI_DATOS=./revisiones
